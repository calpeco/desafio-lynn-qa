# Copie para .env (opcional). Nenhuma variável é obrigatória: os padrões rodam tudo localmente.

# URL de uma API externa. Vazio = sobe a API mock em processo (padrão).
LYNN_BASE_URL=

# Tokens FICTÍCIOS de duas pessoas usuárias (só valem no mock). Nunca commitar tokens reais.
LYNN_TOKEN_ALICE=token-alice
LYNN_TOKEN_BOB=token-bob

# Defeitos a injetar na API mock, separados por vírgula (ver docs/CONTRATO_API.md).
# Ex.: LYNN_FAULTS=no_idempotency,idor   |   ui_double_submit = defeito no frontend
LYNN_FAULTS=

# Habilita /__test__/* (reset, modo do LLM, logs). Apenas ambiente de teste.
LYNN_TEST_CONTROL=1

# Porta do servidor standalone (python -m lynn_mock.server)
LYNN_PORT=8080

# Onde gravar evidências da execução
LYNN_EVIDENCE_DIR=.artifacts

# UI (Playwright): HEADED=1 abre o navegador; SLOW_MO=300 desacelera cada ação (ms)
HEADED=0
SLOW_MO=0
UI_TIMEOUT_MS=5000
