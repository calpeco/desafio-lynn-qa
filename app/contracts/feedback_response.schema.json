{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feedback_response.schema.json",
  "title": "FeedbackResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "rating",
    "comment",
    "updated_at"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "pattern": "^msg_[a-f0-9]{16}$"
    },
    "rating": {
      "enum": [
        "positive",
        "negative"
      ]
    },
    "comment": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
